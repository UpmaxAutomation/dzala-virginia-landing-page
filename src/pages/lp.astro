const jsonLd = {
  "@context":"https://schema.org",
  "@type":"GeneralContractor",
  "name":"Dzala General Contractor",
  "image":"https://dzalacontractor.com/assets/logo/dzala-logo-dark.webp",
  "url":"https://dzalacontractor.com/",
  "telephone":"+1-703-919-1645",
  "email":"dzalausa@gmail.com",
  "priceRange":"$$",
  "address":{"@type":"PostalAddress","streetAddress":"8609 Westwood Center Dr, Ste 110, Unit 119","addressLocality":"Tysons","addressRegion":"VA","postalCode":"22182","addressCountry":"US"},
  "areaServed":["Tysons","McLean","Arlington","Alexandria","Great Falls","Bethesda","Potomac"],
  "openingHoursSpecification":[
    {"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],"opens":"08:00","closes":"19:00"}
  ],
  "makesOffer":["Bathroom Remodeling","Kitchen Remodeling","Whole-Home Remodeling","Basement Remodeling","Home Additions","Bedroom Remodeling","Garage Remodeling","Commercial Remodeling"]
};

const faqLd = {
  "@context":"https://schema.org",
  "@type":"FAQPage",
  "mainEntity":[
    ["How much will my remodel cost?","There is no honest answer to that before someone has seen the space. We come out, look at the scope and give you a written, itemized quote - free, and yours to keep whether or not you hire us."],
    ["Do you offer financing?","Yes. Financing options are available, and we walk you through them during the consultation so you know what the project looks like month to month before you commit."],
    ["What does the warranty cover?","Every project carries a five-year warranty on our labor. Materials and appliances keep their own manufacturer warranties, which we hand over at the final walk-through."],
    ["Who pulls the permits?","We do. Drawings, permit applications and inspections in Fairfax County, Arlington County and Montgomery County, MD are handled by us as part of the project."],
    ["Do you design, or do I need my own designer?","We are design and build under one roof. You can bring your own drawings, but most clients start with us from a blank room - we design the layout around how you use the space, then build it with our own crew."],
    ["Which areas do you serve?","Tysons, McLean, Arlington, Alexandria and Great Falls in Virginia, plus Bethesda and Potomac in Maryland."]
  ].map(([q,a])=>({"@type":"Question","name":q,"acceptedAnswer":{"@type":"Answer","text":a}}))
};
