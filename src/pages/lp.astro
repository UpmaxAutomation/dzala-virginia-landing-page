<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />

<link rel="stylesheet" href="/styles.css" />
</head>
<body>
<a href="#quote" class="skip">Skip to quote form</a>

<div class="topbar">
  <div class="container topbar__in">
    <span class="tb-item"><span class="stars">★★★★★</span> <b>5.0</b> · 47 Google reviews</span>
    <span class="tb-sep tb-hide-sm" aria-hidden="true"></span>
    <span class="tb-item tb-hide-sm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 4 6v6c0 5 3.4 8.5 8 10 4.6-1.5 8-5 8-10V6z"/></svg> Licensed &amp; insured</span>
    <span class="tb-sep tb-hide-sm" aria-hidden="true"></span>
    <span class="tb-item tb-hide-sm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> 24/7 availability</span>
  </div>
</div>

<header id="site-header">
  <div class="container nav">
    <a href="#top" aria-label="Dzala General Contractor, home">
      <img class="logo" src="/assets/logo/dzala-logo-light.webp" alt="Dzala General Contractor" width="900" height="211" />
    </a>
    <div class="nav-cta">
      <a class="nav-phone" href="tel:+17039191645">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        (703) 919-1645
      </a>
      <a class="btn btn--primary" href="#quote">Get A Free Quote</a>
    </div>
  </div>
</header>

<main id="top">

<!-- 1 · HOOK -->
<section class="hero">
  <div class="hero__media" aria-hidden="true"><img class="hero__img" src="/assets/img/hero-kitchen.webp" alt="" /></div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      <div class="eyebrow">Tysons · Northern Virginia</div>
      <h1 class="h1 hero__h1">Your remodel, done right the first time.</h1>
      <p class="hero__sub">Kitchens, baths, basements and whole-home renovations — one crew, one written price, delivered on time. Backed by over a decade of experience.</p>
      <div class="hero__btns">
        <a class="btn btn--primary" href="#quote">Get My Free Quote
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
      <div class="trust-badges">
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 2 3 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.9 21l1.2-6.8-5-4.9 6.9-1z"/></svg> 5.0 · 47 Google reviews</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 4 6v6c0 5 3.4 8.5 8 10 4.6-1.5 8-5 8-10V6z"/></svg> Licensed &amp; insured</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> 24/7 availability</span>
      </div>
    </div>
  </div>
</section>

<!-- 2 · PROBLEM -->
<section class="section section--onyx" data-reveal>
  <div class="container">
    <svg class="roofline" viewBox="0 0 44 16" fill="none" aria-hidden="true"><path d="M2 14 22 3l20 11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    <div class="eyebrow u-mt-18">Sound Familiar?</div>
    <h2 class="h2 h2--sm u-mt-14 measure--title">Most remodels go sideways for the same three reasons.</h2>
    <div class="pain-grid">
      <div class="pain-card"><span class="x"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></span><p><b>Prices that creep up</b>Change orders that blow past the number you were quoted.</p></div>
      <div class="pain-card"><span class="x"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></span><p><b>Crews that disappear</b>Weeks of silence and a half-finished room after the deposit.</p></div>
      <div class="pain-card"><span class="x"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></span><p><b>Permit headaches</b>Chasing inspections and county paperwork on your own.</p></div>
      <div class="pain-card"><span class="x"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></span><p><b>Corners cut where you can't see</b>A finish that doesn't match the promise.</p></div>
    </div>
    <p class="pain-turn">We do it differently — one crew, one written price, one point of accountability.</p>
  </div>
</section>

<!-- 3 · PROOF -->
<section class="section section--gold stats" data-reveal>
  <div class="container stats__grid">
    <div class="stat"><div class="stat__n">10+</div><div class="stat__label">Years of experience</div></div>
    <div class="stat"><div class="stat__n">5.0★</div><div class="stat__label">Google rating</div></div>
    <div class="stat"><div class="stat__n">47</div><div class="stat__label">Google reviews</div></div>
    <div class="stat"><div class="stat__n">24/7</div><div class="stat__label">Availability</div></div>
  </div>
</section>
<section class="section section--deep" data-reveal>
  <div class="container">
    <div class="tst">
      <span class="tst__mark" aria-hidden="true">&ldquo;</span>
      <span class="tst__stars">★★★★★</span>
      <p class="tst__text">Professional, courteous, and highly skilled. The quality of the work was <em>exceptional</em> — completed within the agreed timeline and budget.</p>
      <footer class="tst__attr">Verified Google review · one of 47 five-star ratings</footer>
    </div>
  </div>
</section>

<!-- 4 · SOLUTION -->
<section class="section--lg section--onyx" data-reveal>
  <div class="container">
    <svg class="roofline" viewBox="0 0 44 16" fill="none" aria-hidden="true"><path d="M2 14 22 3l20 11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    <div class="eyebrow u-mt-18">The Dzala Standard</div>
    <h2 class="h2 u-mt-14 measure--title">Four steps, from first visit to final walk-through.</h2>
    <div class="pillar-grid">
      <div class="pillar-card"><div class="pillar-card__n">01</div><h3 class="h3 pillar-card__title">Free consultation</h3><p class="pillar-card__copy">A free in-home visit and a written, itemized quote — before anything begins.</p></div>
      <div class="pillar-card"><div class="pillar-card__n">02</div><h3 class="h3 pillar-card__title">Design &amp; scope</h3><p class="pillar-card__copy">Your plan with real materials, one schedule and one contract.</p></div>
      <div class="pillar-card"><div class="pillar-card__n">03</div><h3 class="h3 pillar-card__title">Permits &amp; build</h3><p class="pillar-card__copy">We handle permits in Fairfax, Arlington &amp; Montgomery County, then build with our own crew.</p></div>
      <div class="pillar-card"><div class="pillar-card__n">04</div><h3 class="h3 pillar-card__title">Final walk-through</h3><p class="pillar-card__copy">One point of accountability, right through a final walk-through of every detail.</p></div>
    </div>
  </div>
</section>

<!-- 5 · EVIDENCE -->
<section class="section--lg section--slate" data-reveal>
  <div class="container">
    <svg class="roofline" viewBox="0 0 44 16" fill="none" aria-hidden="true"><path d="M2 14 22 3l20 11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    <div class="eyebrow u-mt-18">Recent Work</div>
    <h2 class="h2 u-mt-14">Real Northern Virginia projects.</h2>
    <div class="coll-grid">
      <article class="coll-card img-frame"><img class="img-zoom" src="/assets/img/kitchen-marble.webp" alt="Marble kitchen renovation by Dzala General Contractor" /><div class="scrim-bottom"></div><div class="coll-card__body"><h3 class="coll-card__name">Kitchen renovation</h3></div></article>
      <article class="coll-card img-frame"><img class="img-zoom" src="/assets/img/bath-marble.webp" alt="Marble primary bathroom by Dzala General Contractor" /><div class="scrim-bottom"></div><div class="coll-card__body"><h3 class="coll-card__name">Primary bath</h3></div></article>
      <article class="coll-card img-frame"><img class="img-zoom" src="/assets/img/whole-home-exterior.webp" alt="Whole-home renovation by Dzala General Contractor" /><div class="scrim-bottom"></div><div class="coll-card__body"><h3 class="coll-card__name">Whole-home renovation</h3></div></article>
    </div>
  </div>
</section>

<!-- 6 · ACTION -->
<section class="section--lg section--slate consult" data-reveal id="quote">
  <div class="container consult-grid">
    <div>
      <svg class="roofline" viewBox="0 0 44 16" fill="none" aria-hidden="true"><path d="M2 14 22 3l20 11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <div class="eyebrow u-mt-18">Free Quote</div>
      <h2 class="h2 h2--sm">Get your free, written remodeling quote.</h2>
      <p class="prose">Free in-home consultation and a written, itemized quote. We handle permits and inspections in Fairfax County, Arlington County and Montgomery County, MD.</p>
      <ul class="consult-list">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg><span>Written, itemized quote — no mystery pricing.</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg><span>Permits &amp; inspections handled for you.</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg><span>Licensed, insured &amp; available 24/7.</span></li>
      </ul>
      <div class="trust-closer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2 4 6v6c0 5 3.4 8.5 8 10 4.6-1.5 8-5 8-10V6z"/><path d="m9 12 2 2 4-4"/></svg>
        <span>No-pressure consultation. <b>The quote is free</b> — and yours to keep, with no commitment.</span>
      </div>
      <div class="consult-contact">
        <a href="tel:+17039191645"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg> (703) 919-1645</a>
        <a href="mailto:dzalausa@gmail.com"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="1"/><path d="m2 7 10 6 10-6"/></svg> dzalausa@gmail.com</a>
      </div>
    </div>

    <div>
      <form id="lead-form" novalidate>
        <div id="form-fields">
          <p class="fh">Free Quote</p>
          <h3>Tell us about your project</h3>
          <p class="sub">We'll reply within one business day.</p>
          <div class="field">
            <label for="name">Full name</label>
            <input id="name" name="name" type="text" autocomplete="name" required placeholder="Jane Homeowner" />
          </div>
          <div class="form-row">
            <div class="field"><label for="phone">Phone</label><input id="phone" name="phone" type="tel" autocomplete="tel" required placeholder="(703) 000-0000" /></div>
            <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" placeholder="you@email.com" /></div>
          </div>
          <div class="field">
            <label for="service">Project type</label>
            <select id="service" name="service" required>
              <option value="" selected disabled>Select a service…</option>
              <option>Kitchen Remodeling</option>
              <option>Bathroom Remodeling</option>
              <option>Basement Remodeling</option>
              <option>Whole-Home Remodeling</option>
              <option>Home Additions</option>
              <option>Bedroom Remodeling</option>
              <option>Garage Remodeling</option>
              <option>Commercial Remodeling</option>
              <option>Something else</option>
            </select>
          </div>
          <button type="submit" class="btn btn--dark">Get My Free Quote
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
          <p class="fineprint">By submitting, you agree to be contacted about your project. We never share your information.</p>
        </div>
        <div class="form-ok" id="form-ok">
          <div class="ok-i"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m5 13 4 4L19 7"/></svg></div>
          <h3>Thanks — we've got it.</h3>
          <p>A Dzala project lead will reach out within one business day. Need us sooner? Call <a href="tel:+17039191645">(703) 919-1645</a>.</p>
        </div>
      </form>
    </div>
  </div>
</section>

</main>

<footer>
  <div class="container">
    <div class="foot-bottom" style="border:none;padding-top:0">
      <span>© 2026 Dzala General Contractor LLC · Licensed &amp; insured · Tysons, VA</span>
      <a href="tel:+17039191645" style="color:var(--gold);font-weight:600">(703) 919-1645</a>
    </div>
  </div>
</footer>

<!-- STICKY MOBILE CTA -->
<div class="callbar">
  <a class="btn btn--outline-light" href="tel:+17039191645">Call now</a>
  <a class="btn btn--primary" href="#quote">Free quote</a>
</div>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

<!-- single-CTA landing needs only reveal + form; menu code is guarded -->
<script is:inline src="/main.js" defer></script>
</body>
</html>
