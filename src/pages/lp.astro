  "@type":"GeneralContractor",
  "name":"Dzala General Contractor",
  "image":"https://dzalacontractor.com/assets/logo/dzala-logo-dark.webp",
  "url":"https://dzalacontractor.com/",
  "telephone":"+1-703-919-1645",
  "email":"dzalausa@gmail.com",
  "priceRange":"$$",
  "address":{"@type":"PostalAddress","streetAddress":"8609 Westwood Center Dr, Ste 110, Unit 119","addressLocality":"Tysons","addressRegion":"VA","postalCode":"22182","addressCountry":"US"},
  "aggregateRating":{"@type":"AggregateRating","ratingValue":"5.0","reviewCount":"47"},
  "areaServed":["Tysons","McLean","Vienna","Oakton","Great Falls","Arlington","Alexandria","Falls Church","Reston","Herndon","Bethesda","Potomac"],
