<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Free Remodeling Quote — Dzala General Contractor, Northern Virginia</title>
<meta name="description" content="Get a free, written remodeling quote from Dzala General Contractor. Kitchen, bath, basement & whole-home in Tysons and Northern Virginia. Licensed, insured, 5.0★ across 47 Google reviews." />
<link rel="canonical" href="https://dzalacontractor.com/" />
<meta name="theme-color" content="#30373E" />

<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Dzala General Contractor" />
<meta property="og:title" content="Free Remodeling Quote — Dzala General Contractor" />
<meta property="og:description" content="Kitchen, bath, basement & whole-home remodeling in Northern Virginia. Licensed, insured, 5.0★ across 47 Google reviews. Get your free written quote." />
<meta property="og:url" content="https://dzalacontractor.com/" />
<meta property="og:image" content="https://dzalacontractor.com/assets/logo/dzala-logo-dark.webp" />
<meta name="twitter:card" content="summary_large_image" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
